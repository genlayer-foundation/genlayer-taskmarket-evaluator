# Local demo defaults to 127.0.0.1:4731. The live ledger defaults to 127.0.0.1:3000.
# HOST=127.0.0.1
# PORT=3000
# TASKMARKET_DB=data/taskmarket.sqlite
# TASKMARKET_DEMO_DB=data/demo.sqlite

# The worker normally reads data/pilot/bradbury.key and data/pilot/evaluator.
# Set these only when supplying an alternate dedicated test signer or profile.
# GENLAYER_PRIVATE_KEY=
# TASKMARKET_HOME=

# Optional automatic enrollment for a recurring buyer and a specific agreement.
# TASKMARKET_ACCEPT_BRIEF=examples/taskmarket/fixed.json
# TASKMARKET_ACCEPT_REQUESTERS=

# The inherited Virtuals listener is available through npm run start:acp.
# ACP_AGENT_WALLET_ADDRESS=
# ACP_WALLET_ID=
# ACP_SIGNER_PRIVATE_KEY=
# ACP_BUILDER_CODE=
# ACP_CHAIN_ID=8453
# ACP_SERVER_URL=
# API_AUTH_TOKEN=
