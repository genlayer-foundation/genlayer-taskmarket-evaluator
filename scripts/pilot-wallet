#!/bin/sh
# Keep the three test identities independent of the operator's default wallet.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
role=${1:-}
case "$role" in requester|worker|evaluator) shift ;; *) echo "Usage: pilot-wallet requester|worker|evaluator COMMAND ..." >&2; exit 2;; esac
for arg do
  case "$arg" in --network|--network=*) echo "The pilot wallets are bound to Tempo Moderato." >&2; exit 2;; esac
done
export TASKMARKET_HOME="$root/data/pilot/$role" TASKMARKET_NETWORK=tempo-testnet
unset TASKMARKET_API_URL GENLAYER_PRIVATE_KEY
mkdir -p "$TASKMARKET_HOME"
exec "$root/node_modules/.bin/taskmarket" --network tempo-testnet "$@"
